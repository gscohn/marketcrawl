# Copy to .env outside the repo, mode 600, owned by the sportscrawl user.
# Referenced from both systemd units with EnvironmentFile=. Spec section 13.

# Bot account app password with DM access enabled. Full-access credential.
BSKY_APP_PASSWORD=

# Flask session cookie signing and CSRF.
FLASK_SECRET_KEY=

# HMAC key for events.subject. Generated once and NEVER rotated: rotating it
# severs the join between a subscriber's signup and their later churn, which is
# the metric the project exists to gather. Must be in the backup.
EVENTS_PEPPER=

# Basic auth on the admin route.
ADMIN_PASSWORD=

# Operator DID for the hidden `admin` command. Public information, but keeping
# it out of the repo means a leak doesn't also advertise who runs the bot.
ADMIN_DID=

# Absolute path to the SQLite file, outside the document root.
DATABASE_PATH=/home/sportscrawl/data/sportscrawl.db
